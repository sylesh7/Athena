{
  "name": "@athena/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "keys:create": "tsx scripts/create-keys.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "traction": "tsx --env-file=.env.local scripts/traction.ts",
    "scenarios": "tsx --env-file=.env.local scripts/scenarios.ts && tsx --env-file=.env.local scripts/scenarios-report.ts",
    "bootstrap": "tsx --env-file=.env.local scripts/bootstrap.ts",
    "worker": "tsx --env-file=.env.local src/worker.ts",
    "api": "tsx --env-file=.env.local src/api.ts",
    "keeper": "tsx --env-file=.env.local src/keeper.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mcp": "tsx src/mcp/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.33.1",
    "@athena/shared": "workspace:*",
    "@supabase/supabase-js": "2.47.10",
    "cors": "2.8.5",
    "express": "4.21.2",
    "multer": "1.4.5-lts.1",
    "node-cron": "3.0.3",
    "pdf-parse": "1.1.1",
    "pg": "8.13.1",
    "pino": "9.6.0",
    "viem": "2.57.7",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.24.1",
    "@circle-fin/earn-kit": "1.9.0",
    "@circle-fin/adapter-viem-v2": "1.19.1",
    "@circle-fin/app-kit": "1.17.0",
    "@circle-fin/adapter-circle-wallets": "1.8.2",
    "@circle-fin/x402-batching": "3.5.0",
    "@circle-fin/developer-controlled-wallets": "10.8.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "pdfkit": "0.15.2",
    "@x402/core": "^2.3.0",
    "@x402/evm": "^2.3.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.2",
    "@types/node-cron": "3.0.11",
    "@types/pdf-parse": "1.1.4",
    "@types/pg": "8.11.10",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8",
    "@types/pdfkit": "0.13.9"
  }
}
