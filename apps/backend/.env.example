# Copy to apps/backend/.env.local (git-ignored) and fill in. Never commit an RPC URL that embeds an auth token.

# ── network ───────────────────────────────────────────────
NETWORK=testnet                       # testnet | mainnet
RPC_URL=                              # Canteen RPC (arc-canteen rpc-url) for testnet; provider URL for mainnet
RPC_URL_FALLBACK=https://rpc.testnet.arc.io
TREASURY_ADDRESS=                     # after deploy
TREASURY_DEPLOY_BLOCK=                # after deploy; indexer start block
REVEAL_DEADLINE_BLOCKS=7200           # MUST equal the contract's revealDeadlineBlocks (worker refuses to start otherwise)

# ── public addresses (no keys on the server) ──────────────
ADMIN_ADDRESS=
APPROVER_ADDRESS=

# ── database ──────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=            # server only
DATABASE_URL=                         # direct Postgres URL (advisory locks, LISTEN/NOTIFY)

# ── worker-only secrets (the API process does not read these) ──
OPERATOR_PK=
KEEPER_PK=                            # also read by `pnpm keeper`
YIELD_PK=
SPEND_PK=
COLLECTIONS_PK=
VALIDATOR_PK=
RELAYER_PK=
ANTHROPIC_API_KEY=
PLANNER_MODEL=                        # a current Claude model id from Anthropic's docs
EXTRACTOR_MODEL=
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
FX_WALLET_ID=
FX_WALLET_ADDRESS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── operator behavior ─────────────────────────────────────
OPERATOR_ENABLED=true                 # kill switch for new cycles (reveals/recovery keep running)
DRY_RUN=false
SKIP_REVEAL=false                     # scenario S13 only
CYCLE_CRON=*/15 * * * *
FORECAST_HORIZON_DAYS=30
STRESS_INFLOW_DELAY_DAYS=7
STRESS_RECEIVABLE_HAIRCUT_BPS=5000
YIELD_MIN_SWEEP_UNITS=5000000
YIELD_HORIZON_DAYS=14
EARLY_PAY_MARGIN_BPS=200
FX_MAX_DEVIATION_BPS=50

# ── API-only ──────────────────────────────────────────────
API_PORT=3100
ADMIN_API_KEY=                        # >= 24 chars; header x-admin-key for /admin routes
CORS_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3100
FRONTEND_URL=http://localhost:3000
